#!/bin/sh

# Script to run commands in docker. Execute it without parameters to build image.

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

if [ $# -eq 0 ]; then
    exec docker buildx build -t dw1-builder "$SCRIPT_DIR/.."
    exit $?
fi

tty_flags=""
if [ -t 0 ] && [ -t 1 ]; then
    tty_flags="-it"
fi

uid="$(id -u)"
gid="$(id -g)"

exec docker run $tty_flags --rm \
    --user "$uid:$gid" \
    -e HOME=/home/dw1 \
    -e CARGO_HOME=/opt/cargo \
    -v "$SCRIPT_DIR/..:/dw1" \
    dw1-builder "$@"
