+ CONST DIGIMON 0x5d  # Muchomon
+ CONST ENTITY 0x09
+ CONST CHANCE_KEEP 75
+ CONST CHANCE_RAISE 60
+ CONST CHANCE_RAISE2 50
+ CONST CHANCE_LEAVE_1 45
+ CONST CHANCE_LEAVE_2 50
+ CONST CHANCE_LEAVE_3 100

@ DG m202_se
  ADD_TO_PSTAT pstat=0x7b amount=0x01
  LOAD_DIGIMON digimon=$DIGIMON
  SET_DIGIMON digimon=$DIGIMON slot=0x04 autotalk=0x00
  DELAY frames=0x0014
  ENTITY_WALK_TO entity=$ENTITY x=-501 z=-508 animation=0x00 flags=0x00
  WAIT_FOR_ENTITY entity=$ENTITY
  ENTITY_LOOK_AT_ENTITY entity=$ENTITY target=0xfd
  STORE_RANDOM pstat_out=0x6e max=99
  .if
    THEN pstat 0x6e < 30
    if true goto m202_meat
  .end
  .if
    THEN pstat 0x6e < 65
    if true goto m202_portable
  .end
  JUMP_TO m202_medicine



