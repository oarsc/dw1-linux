+ FUNCTION gotoIf chances goto
  STORE_RANDOM pstat_out=0x6e max=99
  .if
    THEN pstat 0x6e < $chances
    if true goto $goto
  .end
.end

+ FUNCTION addProfit high low value
  SET_TEXTBOX_SIZE origin=0x00 columns=12 rows=2

  SET_PSTAT pstat=0xf3 value=$high  # shop variable high byte
  SET_PSTAT pstat=0xf4 value=$low   # shop variable low byte
  CALL_ROUTINE builtin=0x1f         # fn addProfit

  .text
    "Profit: $value"
    "Total Profit: {shop_variable:00}"
  .end
.end

+ FUNCTION addMoodEmote mood
  SET_PSTAT pstat=0xf7 value=$ENTITY  # builtin parameter 1 (entity/script id)
  SET_PSTAT pstat=0xf8 value=$mood    # builtin parameter 2 (mood/amount)
  CALL_ROUTINE builtin=0x1c
.end

+ FUNCTION cleanMoodEmote
  CALL_FUNCTION addMoodEmote mood=0x05
.end



