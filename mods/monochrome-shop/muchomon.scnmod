    "Raise price to 60 bits" -> m202_meat_raise
    "Raise price to 70 bits" -> m202_meat_raise2
  .end
  UNUSED_12
  SET_DIALOG_OWNER entity=0xfd
  .text
    "Uh, you want a good deal on"
    "{color:06}Meat{color:01}, right? Uh..."
  .end
  JUMP_TO m202_meat_decide

