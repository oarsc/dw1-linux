+ DG map 202 section m202_meat_success
  SET_DIALOG_OWNER entity=$ENTITY
  .text
    "Okay, I'll buy it!"
  .end
  PLAY_SOUND bank=0x08 sound=0x06
  DELAY frames=0x000a
  
  .if
    THEN pstat 0x75 == 2
    if true goto m202_meat_success_raise
  .end
  .if
    THEN pstat 0x75 == 3
    if true goto m202_meat_success_raise2
  .end
  CALL_FUNCTION addProfit high=0 low=15 value=15
  JUMP_TO m202_success_leave

+ DG map 202 section m202_meat_success_raise
