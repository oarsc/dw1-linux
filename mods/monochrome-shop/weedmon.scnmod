+ CONST DIGIMON 0x63  # Weedmon
+ CONST ENTITY 0x08
+ CONST CHANCE_KEEP 90
+ CONST CHANCE_RAISE 30
+ CONST CHANCE_RAISE2 15
+ CONST CHANCE_LEAVE_1 20
+ CONST CHANCE_LEAVE_2 60
+ CONST CHANCE_LEAVE_3 90

@ DG m201_se
  ADD_TO_PSTAT pstat=0x7b amount=0x01
  LOAD_DIGIMON digimon=$DIGIMON
  SET_DIGIMON digimon=$DIGIMON slot=0x03 autotalk=0x00
  DELAY frames=0x0014
  ENTITY_WALK_TO entity=$ENTITY x=-501 z=-508 animation=0x00 flags=0x00
  WAIT_FOR_ENTITY entity=$ENTITY
  ENTITY_LOOK_AT_ENTITY entity=$ENTITY target=0xfd
  STORE_RANDOM pstat_out=0x6e max=99
  .if
    THEN pstat 0x6e < 50
    if true goto m201_meat
  .end
  .if
    THEN pstat 0x6e < 80
    if true goto m201_portable
  .end
  JUMP_TO m201_medicine



