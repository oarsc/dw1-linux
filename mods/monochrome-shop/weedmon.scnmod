+ DG map 201 section m201_meat_fail
  CALL_FUNCTION cleanMoodEmote
  ADD_TO_PSTAT pstat=0x77 amount=0x01
  STORE_RANDOM pstat_out=0x6e max=99
  .if
    THEN pstat 0x6e < $CHANCE_LEAVE_1
    AND pstat 0x77 == 0x01
    if true goto m201_angry_leave
  .end
  .if
    THEN pstat 0x6e < $CHANCE_LEAVE_2
    AND pstat 0x77 == 0x02
    if true goto m201_angry_leave
  .end
  .if
    THEN pstat 0x6e < $CHANCE_LEAVE_3
    AND pstat 0x77 >= 0x03
    if true goto m201_angry_leave
  .end
  JUMP_TO m201_meat_retry

