  .end

+ DG map 199 section m199_meat_decide
  CALL_FUNCTION cleanMoodEmote

  SET_PSTAT pstat=0x75 value=0x06
  SET_DIALOG_OWNER entity=0xff
  .selection
    "Keep price at 50 bits" -> m199_meat_keep
    "Raise price to 60 bits" -> m199_meat_raise
    "Raise price to 70 bits" -> m199_meat_raise2
  .end
  UNUSED_12
  SET_DIALOG_OWNER entity=0xfd
  .text
    "Uh, you wanted some"
    "{color:06}Meat{color:01}, right? Uh..."
  .end
  JUMP_TO m199_meat_decide

