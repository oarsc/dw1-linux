+ DG map 199 section m199_meat_success
  SET_DIALOG_OWNER entity=$ENTITY
  .text
    "Good, it's sold!"
  .end
  PLAY_SOUND bank=0x08 sound=0x06
  DELAY frames=0x000a
  
  .if
    THEN pstat 0x75 == 2
    if true goto m199_meat_success_raise
  .end
  .if
    THEN pstat 0x75 == 3
    if true goto m199_meat_success_raise2
  .end
  CALL_FUNCTION addProfit high=0 low=15 value=15
  JUMP_TO m199_success_leave

+ DG map 199 section m199_meat_success_raise
