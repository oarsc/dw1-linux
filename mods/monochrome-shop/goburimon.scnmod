+ CONST DIGIMON 0x50  # Goburimon
+ CONST ENTITY 0x06
+ CONST CHANCE_KEEP 95
+ CONST CHANCE_RAISE 70
+ CONST CHANCE_RAISE2 45
+ CONST CHANCE_LEAVE_1 5
+ CONST CHANCE_LEAVE_2 15
+ CONST CHANCE_LEAVE_3 50

@ DG m199_se
  ADD_TO_PSTAT pstat=0x7b amount=0x01
  LOAD_DIGIMON digimon=$DIGIMON
  SET_DIGIMON digimon=$DIGIMON slot=0x01 autotalk=0x00
  DELAY frames=0x0014
  ENTITY_WALK_TO entity=$ENTITY x=-501 z=-508 animation=0x00 flags=0x00
  WAIT_FOR_ENTITY entity=$ENTITY
  ENTITY_LOOK_AT_ENTITY entity=$ENTITY target=0xfd
  STORE_RANDOM pstat_out=0x6e max=99
  .if
    THEN pstat 0x6e < 30
    if true goto m199_meat
  .end
  .if
    THEN pstat 0x6e < 60
    if true goto m199_portable
  .end
  JUMP_TO m199_medicine



