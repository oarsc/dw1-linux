+ DG map 200 section m200_success_leave
  SET_PSTAT pstat=0x77 value=0x00
  PLAY_SOUND bank=0x00 sound=0x17
  DELAY frames=0x0014
  CALL_FUNCTION cleanMoodEmote
  ENTITY_WALK_TO entity=$ENTITY x=-109 z=-853 animation=0x00 flags=0x00
  WAIT_FOR_ENTITY entity=$ENTITY
  UNLOAD_ENTITY entity=$ENTITY
  UNLOAD_DIGIMON digimon=$DIGIMON
  DELAY frames=0x0014
  JUMP_TO_FILE map=0x0031 section=0x0052
  #.copy m0+0x03fa 0x0002

