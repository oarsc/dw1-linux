+ DG map 200 section m200_meat_success
  SET_DIALOG_OWNER entity=$ENTITY
  .text
    "You got a deal!"
  .end
  PLAY_SOUND bank=0x08 sound=0x06
  DELAY frames=0x000a
  
  .if
    THEN pstat 0x75 == 2
    if true goto m200_meat_success_raise
  .end
  .if
    THEN pstat 0x75 == 3
    if true goto m200_meat_success_raise2
  .end
  CALL_FUNCTION addProfit high=0 low=15 value=15
  JUMP_TO m200_success_leave

+ DG map 200 section m200_meat_success_raise
  CALL_FUNCTION addProfit high=0 low=25 value=25
  JUMP_TO m200_success_leave

