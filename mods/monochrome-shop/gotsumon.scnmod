    "Raise price to 60 bits" -> m200_meat_raise
    "Raise price to 70 bits" -> m200_meat_raise2
  .end
  UNUSED_12
  SET_DIALOG_OWNER entity=0xfd
  .text
    "Uh, you wanted some"
    "{color:06}Meat{color:01}, right? Uh..."
  .end
  JUMP_TO m200_meat_decide

